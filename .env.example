# MongoDB Atlas Connection (preferred: keep credentials in separate env vars)
# Option A (single URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=<app-name>

# Option B (split credentials, safer and easier to rotate):
MONGODB_USERNAME=your-db-username
MONGODB_PASSWORD=your-db-password
MONGODB_CLUSTER_HOST=your-cluster.mongodb.net
MONGODB_DATABASE=andra-meals
MONGODB_APP_NAME=Andra-Meals-Cluster

# JWT Secret - Generate a secure random string
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Auth User Cache (ms) - small TTL reduces DB lookups per request while keeping role/active changes near-real-time
AUTH_USER_CACHE_TTL_MS=10000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Restaurant Configuration
NEXT_PUBLIC_MIN_TABLE_NUMBER=1
NEXT_PUBLIC_MAX_TABLE_NUMBER=20

# Socket Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
